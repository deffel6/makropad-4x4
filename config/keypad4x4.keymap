#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/*
 * Alle 16 Tasten senden Strg+Befehl zusammen mit einer Ziffer oder einer
 * F-Taste, fortlaufend von oben links nach unten rechts:
 *
 *     Tasten 1-10:  Strg+Befehl + 0 bis 9
 *     Tasten 11-16: Strg+Befehl + F1 bis F6
 *
 * Warum diese Kombination: Strg+Befehl+Ziffer ist auf dem Mac praktisch
 * unbelegt, tippt sich nicht versehentlich und erzeugt - anders als
 * Alt+Ziffer - kein Sonderzeichen. Zuweisen lässt sie sich ohne Zusatz-
 * programm in der Kurzbefehle-App über das Feld "Ausführen mit" oder in
 * den Systemeinstellungen unter Tastaturkurzbefehle.
 *
 * In ZMK heißt Strg links LC(...), die Befehlstaste links LG(...), und die
 * Ziffern heißen N0 bis N9. LC(LG(N0)) ist also Strg+Befehl+0.
 *
 * ACHTUNG: Diese Datei wirkt erst, wenn in ZMK Studio einmal
 * "Restore Stock Settings" ausgelöst wurde. Sonst gilt weiter die im Keypad
 * gespeicherte Belegung, und zwar auch nach jedem neuen Flashen.
 *
 * Umbelegen danach wie gehabt im Browser: https://zmk.studio
 */

/ {
	keymap {
		compatible = "zmk,keymap";

		base_layer {
			display-name = "Programme";
			bindings = <
				&kp LC(LG(N0))  &kp LC(LG(N1))  &kp LC(LG(N2))  &kp LC(LG(N3))
				&kp LC(LG(N4))  &kp LC(LG(N5))  &kp LC(LG(N6))  &kp LC(LG(N7))
				&kp LC(LG(N8))  &kp LC(LG(N9))  &kp LC(LG(F1))  &kp LC(LG(F2))
				&kp LC(LG(F3))  &kp LC(LG(F4))  &kp LC(LG(F5))  &kp LC(LG(F6))
			>;
		};

		/* Reserve für Studio: hier lassen sich später Ebenen anlegen */
		extra_1 { status = "reserved"; };
		extra_2 { status = "reserved"; };
	};
};
