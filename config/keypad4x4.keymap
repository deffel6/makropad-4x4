#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/*
 * Alle 16 Tasten sind gleichberechtigte Programmtasten - keine ist für
 * Ebenenwechsel oder Studio-Entsperrung reserviert.
 *
 * Reihen 1-3: F13 bis F24. Diese Tasten gibt es auf keiner gewöhnlichen
 *             Tastatur, kein Systemkürzel belegt sie, und sie erzeugen kein
 *             Zeichen - ein Fehldruck im Textfeld bleibt folgenlos.
 * Reihe 4:    dieselben F13 bis F16 mit Strg+Umschalt+Alt ("Meh"), denn mehr
 *             als zwölf freie F-Tasten kennt der USB-Standard nicht.
 *
 * Ziffern schieden aus: Alt+Ziffer erzeugt auf dem Mac Sonderzeichen wie
 * ¡ € ¶, die im Text landen, sobald kein Programm das Kürzel abfängt.
 * F1 bis F12 schieden aus, dort liegen Helligkeit, Lautstärke und
 * Mission Control.
 *
 * Belegen lassen sich die Tasten in der Kurzbefehle-App (Feld "Ausführen
 * mit", dann die Keypad-Taste drücken), in den Systemeinstellungen unter
 * App-Kurzbefehle, oder in Hammerspoon. Letzteres hat sich als das
 * zuverlässigste erwiesen.
 *
 * ACHTUNG: Diese Datei wirkt erst, wenn in ZMK Studio einmal
 * "Restore Stock Settings" ausgelöst wurde. Sonst gilt weiter die im Keypad
 * gespeicherte Belegung, und zwar auch nach jedem neuen Flashen.
 *
 * Umbelegen danach wie gehabt im Browser: https://zmk.studio
 */

/ {
	keymap {
		compatible = "zmk,keymap";

		base_layer {
			display-name = "Programme";
			bindings = <
				&kp F13              &kp F14              &kp F15              &kp F16
				&kp F17              &kp F18              &kp F19              &kp F20
				&kp F21              &kp F22              &kp F23              &kp F24
				&kp LC(LS(LA(F13)))  &kp LC(LS(LA(F14)))  &kp LC(LS(LA(F15)))  &kp LC(LS(LA(F16)))
			>;
		};

		/* Reserve für Studio: hier lassen sich später Ebenen anlegen */
		extra_1 { status = "reserved"; };
		extra_2 { status = "reserved"; };
	};
};
