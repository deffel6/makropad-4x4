#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
	keymap {
		compatible = "zmk,keymap";

		base_layer {
			display-name = "Zifferblock";
			bindings = <
				&kp KP_N7 &kp KP_N8  &kp KP_N9    &kp KP_SLASH
				&kp KP_N4 &kp KP_N5  &kp KP_N6    &kp KP_MULTIPLY
				&kp KP_N1 &kp KP_N2  &kp KP_N3    &kp KP_MINUS
				&kp KP_N0 &kp KP_DOT &kp KP_ENTER &mo 1
			>;
		};

		fn_layer {
			display-name = "F13-F24";
			bindings = <
				&kp F13    &kp F14      &kp F15      &kp F16
				&kp F17    &kp F18      &kp F19      &kp F20
				&kp F21    &kp F22      &kp F23      &studio_unlock
				&kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans
			>;
		};

		/* Reserve für Studio: hier lassen sich später Ebenen anlegen */
		extra_1 { status = "reserved"; };
		extra_2 { status = "reserved"; };
	};
};
