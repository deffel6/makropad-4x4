#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/*
 * Alle 16 Tasten senden blanke F-Tasten, fortlaufend von oben links nach
 * unten rechts: F1 bis F16.
 *
 * Zu beachten: F1 bis F12 sind auf dem Mac nicht frei. Dort liegen je nach
 * Einstellung Helligkeit, Mission Control, Spotlight, Diktat und Lautstärke.
 * Wer diese Tasten als Auslöser nutzen will, schaltet in den Systemein-
 * stellungen unter Tastatur "F1, F2 usw. als Standardfunktionstasten
 * verwenden" ein - sonst greifen die Systemfunktionen zuerst.
 * F13 bis F16 sind dagegen unbelegt.
 *
 * ACHTUNG: Diese Datei wirkt erst, wenn in ZMK Studio einmal
 * "Restore Stock Settings" ausgelöst wurde. Sonst gilt weiter die im Keypad
 * gespeicherte Belegung, und zwar auch nach jedem neuen Flashen.
 *
 * Umbelegen danach wie gehabt im Browser: https://zmk.studio
 */

/ {
	keymap {
		compatible = "zmk,keymap";

		base_layer {
			display-name = "Programme";
			bindings = <
				&kp F1   &kp F2   &kp F3   &kp F4
				&kp F5   &kp F6   &kp F7   &kp F8
				&kp F9   &kp F10  &kp F11  &kp F12
				&kp F13  &kp F14  &kp F15  &kp F16
			>;
		};

		/* Reserve für Studio: hier lassen sich später Ebenen anlegen */
		extra_1 { status = "reserved"; };
		extra_2 { status = "reserved"; };
	};
};
