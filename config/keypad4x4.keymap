#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/*
 * Alle 16 Tasten senden Umschalt links + Alt rechts zusammen mit F1 bis F16,
 * fortlaufend von oben links nach unten rechts.
 *
 * Warum diese Kombination: Umschalt+Alt+F-Taste tippt niemand versehentlich,
 * und sie erzeugt kein Zeichen. Jede Taste ist damit ein eindeutiger Auslöser,
 * den sich Hammerspoon, die Kurzbefehle-App oder jedes andere Programm greifen
 * kann, ohne einer normalen Tastatur ins Gehege zu kommen.
 *
 * Warum F1 bis F16 statt der Ziffern 1 bis 16: Ziffern gibt es nur zehn.
 * F-Tasten reichen bis F24 und lassen sich sauber durchnummerieren.
 *
 * In ZMK heißt Umschalt links LS(...) und Alt rechts RA(...), geschachtelt
 * also LS(RA(F1)). Das entspricht LSFT(RALT(KC_F1)) in QMK.
 *
 * Auf dem Mac ist Alt rechts die rechte Wahltaste (Option).
 *
 * ACHTUNG: Diese Datei wirkt erst, wenn in ZMK Studio einmal
 * "Restore Stock Settings" ausgelöst wurde. Sonst gilt weiter die im Keypad
 * gespeicherte Belegung, und zwar auch nach jedem neuen Flashen.
 *
 * Umbelegen danach wie gehabt im Browser: https://zmk.studio
 */

/ {
	keymap {
		compatible = "zmk,keymap";

		base_layer {
			display-name = "Programme";
			bindings = <
				&kp LS(RA(F1))   &kp LS(RA(F2))   &kp LS(RA(F3))   &kp LS(RA(F4))
				&kp LS(RA(F5))   &kp LS(RA(F6))   &kp LS(RA(F7))   &kp LS(RA(F8))
				&kp LS(RA(F9))   &kp LS(RA(F10))  &kp LS(RA(F11))  &kp LS(RA(F12))
				&kp LS(RA(F13))  &kp LS(RA(F14))  &kp LS(RA(F15))  &kp LS(RA(F16))
			>;
		};

		/* Reserve für Studio: hier lassen sich später Ebenen anlegen */
		extra_1 { status = "reserved"; };
		extra_2 { status = "reserved"; };
	};
};
