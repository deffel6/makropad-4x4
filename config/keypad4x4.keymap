#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/*
 * Tasten 1 bis 10:  Strg zusammen mit den Ziffern 0 bis 9.
 * Tasten 11 bis 16:  F11 bis F16, unverändert aus der vorigen Fassung.
 *
 * Strg+Ziffer erzeugt kein Zeichen und ist auf dem Mac weitgehend frei -
 * einzelne Programme nutzen es zum Umschalten zwischen Tabs.
 *
 * Zu beachten bei F11 und F12: Dort liegen am Mac Lautstärke und Mission
 * Control. Wer sie als Auslöser braucht, schaltet in den Systemein-
 * stellungen unter Tastatur "F1, F2 usw. als Standardfunktionstasten
 * verwenden" ein. F13 bis F16 sind frei.
 *
 * In ZMK heißt Strg links LC(...), die Ziffern heißen N0 bis N9.
 *
 * ACHTUNG: Diese Datei wirkt erst, wenn in ZMK Studio einmal
 * "Restore Stock Settings" ausgelöst wurde. Sonst gilt weiter die im Keypad
 * gespeicherte Belegung, und zwar auch nach jedem neuen Flashen.
 *
 * Umbelegen danach wie gehabt im Browser: https://zmk.studio
 */

/ {
	keymap {
		compatible = "zmk,keymap";

		base_layer {
			display-name = "Programme";
			bindings = <
				&kp LC(N0)  &kp LC(N1)  &kp LC(N2)  &kp LC(N3)
				&kp LC(N4)  &kp LC(N5)  &kp LC(N6)  &kp LC(N7)
				&kp LC(N8)  &kp LC(N9)  &kp F11     &kp F12
				&kp F13     &kp F14     &kp F15     &kp F16
			>;
		};

		/* Reserve für Studio: hier lassen sich später Ebenen anlegen */
		extra_1 { status = "reserved"; };
		extra_2 { status = "reserved"; };
	};
};
